{
  "name": "distribuicao-aulas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p testes && tsc --noEmit -p testes/smoke",
    "test:smoke": "wdio run testes/smoke/wdio.conf.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:solver": "vite-node scripts/bench_solver.ts --"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
